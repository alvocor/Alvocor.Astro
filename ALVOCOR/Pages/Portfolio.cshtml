@page
@{
    ViewData["Title"] = "Portfolio";
    ViewData["Description"] = "Anonymized ALVOCOR LLC case study examples covering workflow platforms, API integration, legacy modernization, and AI-assisted automation.";
    ViewData["CanonicalPath"] = "/Portfolio";
}

<section class="page-hero">
    <div class="container">
        <div class="eyebrow mb-3">Portfolio</div>
        <h1 class="display-5 fw-bold mb-3">Representative project examples.</h1>
        <p class="lead mb-0">These anonymized examples illustrate the kinds of software, integration, modernization, and automation work ALVOCOR can support.</p>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <article class="case-card h-100">
                    <div class="section-kicker">Workflow Systems</div>
                    <h2>Enterprise Workflow Platform</h2>
                    <p>Designed a role-based platform concept for tracking operational requests, approvals, status changes, reporting, and administrative workflows.</p>
                    <p><strong>Focus:</strong> User experience, business rules, data modeling, reporting, auditability, and maintainable application architecture.</p>
                    <p class="tech-line">ASP.NET Core, SQL Server, Entity Framework Core, Bootstrap, role-based access</p>
                </article>
            </div>
            <div class="col-md-6">
                <article class="case-card h-100">
                    <div class="section-kicker">Integration</div>
                    <h2>API Integration &amp; Automation</h2>
                    <p>Planned secure API integrations to reduce repeated data entry, coordinate handoffs between systems, and standardize error handling.</p>
                    <p><strong>Focus:</strong> REST APIs, authentication, background processing, logging, retries, and operational monitoring.</p>
                    <p class="tech-line">Web API, OAuth, JSON, SQL Server, scheduled jobs, webhooks</p>
                </article>
            </div>
            <div class="col-md-6">
                <article class="case-card h-100">
                    <div class="section-kicker">Modernization</div>
                    <h2>Legacy Application Modernization</h2>
                    <p>Outlined an incremental modernization path for older business software, balancing feature continuity with maintainability improvements.</p>
                    <p><strong>Focus:</strong> Code assessment, database access improvements, UI refresh, deployment simplification, and staged migration planning.</p>
                    <p class="tech-line">.NET, ASP.NET Core, SQL Server, Entity Framework Core, Azure-ready deployment</p>
                </article>
            </div>
            <div class="col-md-6">
                <article class="case-card h-100">
                    <div class="section-kicker">AI Automation</div>
                    <h2>AI-Assisted Process Automation</h2>
                    <p>Created an automation approach for using AI to assist with information intake, summarization, classification, and task routing.</p>
                    <p><strong>Focus:</strong> Human review, data privacy, prompt structure, workflow fit, measurable time savings, and responsible AI use.</p>
                    <p class="tech-line">OpenAI APIs, .NET, Python, document processing, workflow automation</p>
                </article>
            </div>
        </div>
    </div>
</section>
