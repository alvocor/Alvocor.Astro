@page
@model IndexModel
@{
    ViewData["Title"] = "Enterprise Software Development & AI Consulting";
    ViewData["Description"] = "ALVOCOR LLC provides enterprise software development, AI solutions, cloud consulting, API integration, automation, and application modernization services.";
}

<section id="home" class="hero-section position-relative overflow-hidden">
    <div class="container py-5 py-lg-6">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="eyebrow mb-3">ALVOCOR LLC</div>
                <h1 class="display-4 fw-bold hero-title mb-4">
                    Enterprise Software Development &amp; AI Consulting
                </h1>
                <p class="lead hero-lead mb-4">
                    We help organizations design, modernize, integrate, and automate secure business systems using modern .NET, cloud, API, data, and AI technologies.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge rounded-pill text-bg-light hero-badge">Custom Software</span>
                    <span class="badge rounded-pill text-bg-light hero-badge">AI Automation</span>
                    <span class="badge rounded-pill text-bg-light hero-badge">Cloud Solutions</span>
                    <span class="badge rounded-pill text-bg-light hero-badge">API Integration</span>
                    <span class="badge rounded-pill text-bg-light hero-badge">Digital Transformation</span>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary btn-lg" href="mailto:contact@alvocor.com">Discuss a Project</a>
                    <a class="btn btn-outline-light btn-lg" href="#services">Explore Services</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-card text-center p-4 p-lg-5">
                    <img src="~/images/assets/alvocor-logo-full.png" asp-append-version="true" alt="ALVOCOR LLC logo" class="img-fluid hero-logo mb-4" />
                    <p class="mb-0 text-white-50">Innovate. Automate. Accelerate.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="about" class="section-pad bg-white">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="section-kicker">About ALVOCOR</div>
                <h2 class="section-title">Practical technology solutions for modern business needs.</h2>
                <p class="section-text">
                    ALVOCOR LLC is a technology consulting and development firm focused on delivering secure, scalable, and maintainable software solutions. We support businesses with custom applications, cloud integration, workflow automation, application modernization, and AI-powered solutions.
                </p>
                <p class="section-text">
                    Our approach combines enterprise software engineering experience with modern cloud and AI capabilities to help organizations streamline operations, improve productivity, and build technology that can grow with the business.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="mission-panel p-4 p-lg-5">
                    <h3 class="h4 mb-3">Our Mission</h3>
                    <p class="mb-4">To deliver innovative software, AI automation, and cloud solutions that help businesses modernize, streamline operations, and accelerate growth.</p>
                    <div class="row g-3">
                        <div class="col-sm-6"><div class="metric-card"><strong>Secure</strong><span>Business systems</span></div></div>
                        <div class="col-sm-6"><div class="metric-card"><strong>Scalable</strong><span>Cloud-ready design</span></div></div>
                        <div class="col-sm-6"><div class="metric-card"><strong>Modern</strong><span>.NET, APIs, AI</span></div></div>
                        <div class="col-sm-6"><div class="metric-card"><strong>Practical</strong><span>Outcome-focused</span></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="services" class="section-pad services-section">
    <div class="container">
        <div class="text-center mx-auto section-heading">
            <div class="section-kicker">What We Do</div>
            <h2 class="section-title">Services built around software, cloud, automation, and AI.</h2>
            <p class="section-text">ALVOCOR supports the full lifecycle of modern business technology: planning, architecture, implementation, integration, modernization, and ongoing improvement.</p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-md-6 col-xl-4"><article class="service-card h-100"><div class="service-icon">&lt;/&gt;</div><h3>Custom Software Development</h3><p>Design and development of secure web, desktop, cloud, and enterprise applications tailored to business workflows.</p></article></div>
            <div class="col-md-6 col-xl-4"><article class="service-card h-100"><div class="service-icon">AI</div><h3>AI Automation</h3><p>AI-powered workflow automation, intelligent assistants, document processing, and practical business process optimization.</p></article></div>
            <div class="col-md-6 col-xl-4"><article class="service-card h-100"><div class="service-icon">☁</div><h3>Cloud Solutions</h3><p>Cloud-ready architecture, Azure and AWS integration, deployment planning, containers, and scalable infrastructure support.</p></article></div>
            <div class="col-md-6 col-xl-4"><article class="service-card h-100"><div class="service-icon">API</div><h3>API Development &amp; Integration</h3><p>REST APIs, system integration, authentication, data workflows, and enterprise connectivity between platforms.</p></article></div>
            <div class="col-md-6 col-xl-4"><article class="service-card h-100"><div class="service-icon">↗</div><h3>Application Modernization</h3><p>Modernization of legacy systems, refactoring, migration planning, performance improvements, and maintainability upgrades.</p></article></div>
            <div class="col-md-6 col-xl-4"><article class="service-card h-100"><div class="service-icon">⚙</div><h3>Technology Consulting</h3><p>Software architecture, digital transformation, technical strategy, proof-of-concept development, and solution design.</p></article></div>
        </div>
    </div>
</section>

<section id="technologies" class="section-pad bg-white">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-5">
                <div class="section-kicker">Technology Focus</div>
                <h2 class="section-title">Modern tools for dependable business systems.</h2>
                <p class="section-text">Development work is centered around Microsoft technologies, cloud-integrated architecture, secure APIs, automation, and modern AI-assisted development workflows.</p>
            </div>
            <div class="col-lg-7">
                <div class="tech-cloud">
                    <span>.NET</span><span>ASP.NET Core</span><span>C#</span><span>Web API</span><span>Entity Framework Core</span><span>SQL Server</span><span>Azure</span><span>AWS</span><span>Docker</span><span>Linux</span><span>Python</span><span>React</span><span>Angular</span><span>REST APIs</span><span>Authentication</span><span>Authorization</span><span>OpenAI</span><span>GitHub Copilot</span><span>Claude Code</span><span>Automation</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <h2 class="mb-3">Need help building, modernizing, or automating business software?</h2>
                <p class="mb-0">Let's discuss your goals and identify a practical path from idea to implementation.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a class="btn btn-light btn-lg" href="mailto:contact@alvocor.com">Contact ALVOCOR</a>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="section-pad contact-section">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6">
                <h2 class="section-title">Contact</h2>
                <p class="section-text">For software development, AI automation, cloud consulting, or technology strategy inquiries, contact ALVOCOR LLC.</p>
            </div>
            <div class="col-lg-6">
                <div class="contact-card p-4 h-100">
                    <p><strong>Email:</strong> <a href="mailto:contact@alvocor.com">contact@alvocor.com</a></p>
                    <p><strong>Website:</strong> <a href="https://alvocor.com">https://alvocor.com</a></p>
                    <p><strong>Phone:</strong> <a href="tel:+14842889153">(484) 288-9153</a></p>
                    <p class="mb-0"><strong>Location:</strong> Exton, Pennsylvania · Remote services available</p>
                </div>
            </div>
        </div>
    </div>
</section>
