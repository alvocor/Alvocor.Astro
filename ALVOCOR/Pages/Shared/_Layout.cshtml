<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ALVOCOR LLC</title>
    <meta name="description" content="@(ViewData["Description"] ?? "ALVOCOR LLC provides enterprise software development, AI solutions, cloud consulting, API integration, automation, and technology consulting services.")" />
    <meta name="theme-color" content="#0D1B2A" />

    <meta property="og:title" content="@ViewData["Title"] | ALVOCOR LLC" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Enterprise software development, AI solutions, cloud consulting, automation, and digital transformation.")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://alvocor.com" />
    <meta property="og:image" content="https://alvocor.com/images/assets/alvocor-business-cover.png" />

    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ALVOCOR.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header fixed-top">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index" aria-label="ALVOCOR LLC Home">
                    <img src="~/images/assets/alvocor-logo-mark.png" asp-append-version="true" alt="ALVOCOR logo mark" class="brand-mark" />
                    <span class="brand-text">ALVOCOR LLC</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index" asp-fragment="home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index" asp-fragment="about">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index" asp-fragment="services">Services</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index" asp-fragment="technologies">Technologies</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a></li>
                        <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-3" href="mailto:alex@alvocor.com">Contact</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-4">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <div class="fw-semibold">ALVOCOR LLC</div>
                    <div class="small text-white-50">Enterprise Software Development • AI Solutions • Cloud Consulting</div>
                </div>
                <div class="col-md-4 text-md-end small">
                    © 2026 ALVOCOR LLC · <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
