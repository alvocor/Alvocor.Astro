@page
@{
    ViewData["Title"] = "Services";
    ViewData["Description"] = "Enterprise software development, AI automation, cloud solutions, API integration, application modernization, and technology consulting services from ALVOCOR LLC.";
    ViewData["CanonicalPath"] = "/Services";
}

<section class="page-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="eyebrow mb-3">Services</div>
                <h1 class="display-5 fw-bold mb-3">Software, cloud, automation, and AI consulting for modern business operations.</h1>
                <p class="lead mb-0">ALVOCOR provides focused technical execution for organizations that need reliable systems, cleaner integrations, and practical modernization.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a class="btn btn-primary btn-lg" asp-page="/Contact">Schedule a Consultation</a>
            </div>
        </div>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <article class="detail-card h-100">
                    <h2>Enterprise Software Development</h2>
                    <p>Custom web applications, internal portals, workflow tools, data-driven systems, and business platforms designed for maintainability.</p>
                    <h3>Business value</h3>
                    <p>Replace manual workarounds, improve operational visibility, and create systems that match the way your organization actually works.</p>
                    <h3>Related technologies</h3>
                    <p class="tech-line">C#, ASP.NET Core, Razor Pages, Web API, Entity Framework Core, SQL Server, Bootstrap, JavaScript</p>
                </article>
            </div>
            <div class="col-lg-6">
                <article class="detail-card h-100">
                    <h2>AI Automation</h2>
                    <p>AI-assisted workflows, intelligent document processing, internal assistants, content handling, and automation for repetitive knowledge work.</p>
                    <h3>Business value</h3>
                    <p>Reduce repetitive effort, improve response time, and help teams make better use of structured and unstructured information.</p>
                    <h3>Related technologies</h3>
                    <p class="tech-line">OpenAI APIs, Azure AI, Python, .NET, prompt design, retrieval patterns, workflow automation</p>
                </article>
            </div>
            <div class="col-lg-6">
                <article class="detail-card h-100">
                    <h2>Cloud Solutions</h2>
                    <p>Cloud-ready application architecture, deployment planning, migration support, infrastructure guidance, and scalable hosting patterns.</p>
                    <h3>Business value</h3>
                    <p>Improve reliability, simplify deployments, support growth, and align infrastructure choices with business needs.</p>
                    <h3>Related technologies</h3>
                    <p class="tech-line">Azure, AWS, App Service, SQL Database, containers, CI/CD, identity, observability</p>
                </article>
            </div>
            <div class="col-lg-6">
                <article class="detail-card h-100">
                    <h2>API Development &amp; Integration</h2>
                    <p>REST APIs, authentication, third-party integrations, data synchronization, and secure connectivity between business systems.</p>
                    <h3>Business value</h3>
                    <p>Eliminate duplicate entry, connect fragmented systems, and create dependable automation between tools and teams.</p>
                    <h3>Related technologies</h3>
                    <p class="tech-line">ASP.NET Core Web API, REST, OAuth, JSON, SQL Server, webhooks, background jobs</p>
                </article>
            </div>
            <div class="col-lg-6">
                <article class="detail-card h-100">
                    <h2>Application Modernization</h2>
                    <p>Assessment and modernization of legacy applications, database access, deployment practices, user interfaces, and integration points.</p>
                    <h3>Business value</h3>
                    <p>Reduce maintenance risk, improve performance, extend system life, and create a practical path toward modern architecture.</p>
                    <h3>Related technologies</h3>
                    <p class="tech-line">.NET, ASP.NET Core, SQL Server, Entity Framework Core, Bootstrap, Azure, automated testing</p>
                </article>
            </div>
            <div class="col-lg-6">
                <article class="detail-card h-100">
                    <h2>Technology Consulting</h2>
                    <p>Architecture reviews, technical planning, proof-of-concept development, vendor evaluation support, and implementation roadmaps.</p>
                    <h3>Business value</h3>
                    <p>Clarify tradeoffs, reduce execution risk, and turn ambiguous technology needs into concrete delivery plans.</p>
                    <h3>Related technologies</h3>
                    <p class="tech-line">.NET architecture, cloud strategy, API design, database design, automation strategy, AI readiness</p>
                </article>
            </div>
        </div>
    </div>
</section>
