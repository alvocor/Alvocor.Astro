@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["Description"] = "Privacy Policy for ALVOCOR LLC.";
}

<section class="page-hero small-hero">
    <div class="container">
        <h1 class="display-5 fw-bold mb-3">Privacy Policy</h1>
        <p class="lead mb-0">ALVOCOR LLC respects your privacy and is committed to handling business inquiries responsibly.</p>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container privacy-content">
        <p><strong>Effective date:</strong> June 2026</p>

        <h2>Information We Collect</h2>
        <p>When you contact ALVOCOR LLC, we may collect information you choose to provide, such as your name, email address, phone number, company name, and details about your project or inquiry.</p>

        <h2>How We Use Information</h2>
        <p>We use submitted information to respond to inquiries, discuss potential services, provide estimates, deliver consulting or development services, and maintain business records.</p>

        <h2>Information Sharing</h2>
        <p>We do not sell personal information. Information may be shared only when necessary to operate the business, comply with legal obligations, or provide requested services with your permission.</p>

        <h2>Data Security</h2>
        <p>We take reasonable steps to protect information submitted to us. However, no method of electronic transmission or storage is completely secure.</p>

        <h2>Third-Party Services</h2>
        <p>This website may use third-party hosting, analytics, email, or communication services. Those providers may process data according to their own privacy policies.</p>

        <h2>Contact</h2>
        <p>Questions about this Privacy Policy can be sent to <a href="mailto:alex@alvocor.com">alex@alvocor.com</a>.</p>
    </div>
</section>
