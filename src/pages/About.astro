---
import Layout from "../layouts/Layout.astro";
---
<Layout title="About" description="Learn about ALVOCOR LLC and Alexander Osavoltchouk, Founder and Principal Consultant, focused on enterprise .NET, full-stack development, APIs, SQL Server, cloud, automation, modernization, and AI-assisted development." canonicalPath="/About">
<section class="page-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-9">
                <div class="eyebrow mb-3">About ALVOCOR</div>
                <h1 class="display-5 fw-bold mb-3">A boutique consulting firm focused on practical enterprise technology.</h1>
                <p class="lead mb-0">ALVOCOR LLC helps organizations build, modernize, integrate, and automate software systems with a clear focus on business value and maintainable engineering.</p>
            </div>
        </div>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-7">
                <div class="section-kicker">Founder</div>
                <h2 class="section-title">Alexander Osavoltchouk, Founder &amp; Principal Consultant</h2>
                <p class="section-text">Alexander leads ALVOCOR LLC with experience across enterprise .NET development, full-stack application delivery, API design, SQL Server-backed systems, cloud solutions, workflow automation, modernization initiatives, and AI-assisted development practices.</p>
                <p class="section-text">The firm is structured for clients that need direct technical expertise, pragmatic architecture, and implementation support without the complexity of a large consulting engagement.</p>
            </div>
            <div class="col-lg-5">
                <div class="mission-panel p-4 p-lg-5">
                    <h3 class="h4 mb-3">Core principles</h3>
                    <ul class="check-list mb-0">
                        <li>Build systems that are understandable and maintainable.</li>
                        <li>Use cloud and AI where they provide real operational value.</li>
                        <li>Modernize incrementally when that lowers risk.</li>
                        <li>Communicate tradeoffs clearly before implementation.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

</Layout>
