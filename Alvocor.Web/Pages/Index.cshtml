@page
@model IndexModel
@{
    ViewData["Title"] = "Enterprise Software Development & AI Consulting";
    ViewData["Description"] = "ALVOCOR LLC is a boutique technology consulting firm providing enterprise software development, AI automation, cloud solutions, API integration, application modernization, and technology consulting.";
    ViewData["CanonicalPath"] = "/";
    ViewData["PreloadImage"] = "/images/assets/alvocor-business-cover.png";
}

<section class="hero-section position-relative overflow-hidden">
    <div class="container py-5 py-lg-6">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="eyebrow mb-3">ALVOCOR LLC</div>
                <h1 class="display-4 fw-bold hero-title mb-4">Boutique enterprise software development and AI consulting.</h1>
                <p class="lead hero-lead mb-4">
                    ALVOCOR1 helps organizations design, modernize, integrate, and automate dependable business systems using modern .NET, cloud, API, data, and AI technologies.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4" aria-label="Core capabilities">
                    <span class="badge rounded-pill hero-badge">Innovate.</span>
                    <span class="badge rounded-pill hero-badge">Automate.</span>
                    <span class="badge rounded-pill hero-badge">Accelerate.</span>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary btn-lg" asp-page="/Contact">Schedule a Consultation</a>
                    <a class="btn btn-outline-light btn-lg" asp-page="/Services">View Services</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-card text-center p-4 p-lg-5">
                    <img src="~/images/assets/alvocor-logo-full.png" asp-append-version="true" alt="ALVOCOR LLC logo" class="img-fluid hero-logo mb-4" decoding="async" fetchpriority="high" />
                    <p class="mb-0 text-white-50">Enterprise software, automation, cloud, APIs, modernization, and practical AI solutions.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container">
        <div class="text-center mx-auto section-heading">
            <div class="section-kicker">Services</div>
            <h2 class="section-title">Focused technology services for business systems.</h2>
            <p class="section-text">From strategy through implementation, ALVOCOR supports practical software initiatives that improve operations and reduce technical friction.</p>
        </div>
        <div class="row g-4 mt-4">
            <div class="col-md-6 col-xl-4">
                <article class="service-card h-100">
                    <div class="service-icon icon-code" aria-hidden="true">&lt;/&gt;</div>
                    <h3>Enterprise Software Development</h3>
                    <p>Custom applications, portals, internal tools, and maintainable platforms built around real business workflows.</p>
                </article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="service-card h-100">
                    <div class="service-icon icon-ai" aria-hidden="true">AI</div>
                    <h3>AI Automation</h3>
                    <p>Practical AI-assisted workflows, document handling, knowledge tools, and automation patterns for repeatable tasks.</p>
                </article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="service-card h-100">
                    <div class="service-icon icon-cloud" aria-hidden="true">CL</div>
                    <h3>Cloud Solutions</h3>
                    <p>Cloud-ready architecture, migrations, deployment planning, and scalable infrastructure guidance.</p>
                </article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="service-card h-100">
                    <div class="service-icon icon-api" aria-hidden="true">API</div>
                    <h3>API Development &amp; Integration</h3>
                    <p>Secure APIs and integrations that connect systems, synchronize data, and automate handoffs.</p>
                </article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="service-card h-100">
                    <div class="service-icon icon-modernize" aria-hidden="true">MOD</div>
                    <h3>Application Modernization</h3>
                    <p>Incremental modernization for legacy applications, databases, deployment processes, and maintainability challenges.</p>
                </article>
            </div>
            <div class="col-md-6 col-xl-4">
                <article class="service-card h-100">
                    <div class="service-icon icon-consulting" aria-hidden="true">TC</div>
                    <h3>Technology Consulting</h3>
                    <p>Architecture, technical planning, proof-of-concept development, and implementation support for software decisions.</p>
                </article>
            </div>
        </div>
        <div class="text-center mt-5">
            <a class="btn btn-outline-primary btn-lg" asp-page="/Services">Explore all services</a>
        </div>
    </div>
</section>

<section class="section-pad services-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <div class="section-kicker">Why ALVOCOR</div>
                <h2 class="section-title">Senior technical execution without unnecessary overhead.</h2>
                <p class="section-text">ALVOCOR is built for organizations that need thoughtful engineering, clear communication, and realistic implementation plans from a focused consulting partner.</p>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-sm-6"><div class="metric-card h-100"><strong>Practical architecture</strong><span>Solutions that fit your team, systems, and budget.</span></div></div>
                    <div class="col-sm-6"><div class="metric-card h-100"><strong>Enterprise experience</strong><span>.NET, APIs, SQL Server, integrations, cloud, and automation.</span></div></div>
                    <div class="col-sm-6"><div class="metric-card h-100"><strong>Maintainable delivery</strong><span>Readable code, documented choices, and incremental paths forward.</span></div></div>
                    <div class="col-sm-6"><div class="metric-card h-100"><strong>Modern capability</strong><span>Cloud-native patterns and AI-assisted workflows applied responsibly.</span></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-5">
                <div class="section-kicker">Technology Focus</div>
                <h2 class="section-title">Modern tools for dependable business systems.</h2>
                <p class="section-text">ALVOCOR focuses on proven platforms and integration patterns that support secure, scalable, and maintainable software.</p>
            </div>
            <div class="col-lg-7">
                <div class="tech-cloud">
                    <span>.NET</span><span>ASP.NET Core</span><span>C#</span><span>Razor Pages</span><span>Web API</span><span>Entity Framework Core</span><span>SQL Server</span><span>Azure</span><span>AWS</span><span>Docker</span><span>REST APIs</span><span>Authentication</span><span>Automation</span><span>AI-assisted development</span><span>OpenAI</span><span>GitHub</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <h2 class="mb-3">Ready to improve a business system or plan a modernization effort?</h2>
                <p class="mb-0">Schedule a focused consultation to discuss goals, constraints, and practical next steps.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a class="btn btn-light btn-lg" asp-page="/Contact">Schedule a Consultation</a>
            </div>
        </div>
    </div>
</section>
