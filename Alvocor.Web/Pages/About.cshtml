@page
@{
    ViewData["Title"] = "About ALVOCOR LLC";
    ViewData["Description"] = "Learn about ALVOCOR LLC, a technology consulting firm specializing in enterprise .NET development, full-stack applications, API integration, SQL Server, cloud solutions, workflow automation, modernization, and AI-assisted software development.";
    ViewData["CanonicalPath"] = "/About";
}

<section class="page-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-9">
                <div class="eyebrow mb-3">About ALVOCOR LLC</div>
                <h1 class="display-5 fw-bold mb-3">
                    Technology consulting built around real business needs.
                </h1>
                <p class="lead mb-0">
                    ALVOCOR LLC helps organizations develop, modernize,
                    integrate, and automate software solutions through
                    practical engineering, thoughtful architecture, and
                    reliable implementation.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section-pad bg-white">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-7">
                <div class="section-kicker">Who We Are</div>
                <h2 class="section-title">
                    Engineering expertise. Practical solutions. Lasting value.
                </h2>
                <p class="section-text">
                    ALVOCOR LLC is a technology consulting firm focused on
                    helping businesses solve complex technical challenges
                    and build dependable software systems. The company
                    combines hands-on engineering with a practical approach
                    to architecture, integration, and software delivery.
                </p>
                <p class="section-text">
                    Areas of expertise include enterprise .NET development,
                    full-stack application engineering, API design and
                    integration, SQL Server-backed systems, cloud solutions,
                    workflow automation, and legacy system modernization.
                </p>
                <p class="section-text">
                    ALVOCOR LLC also applies AI-assisted development and
                    intelligent automation where they can improve engineering
                    efficiency, streamline business processes, and support
                    innovation.
                </p>
            </div>

            <div class="col-lg-5">
                <div class="mission-panel p-4 p-lg-5">
                    <h3 class="h4 mb-3">Our Core Principles</h3>
                    <ul class="check-list mb-0">
                        <li>
                            <strong>Practical engineering.</strong>
                            Deliver solutions that address real business
                            requirements.
                        </li>
                        <li>
                            <strong>Maintainable architecture.</strong>
                            Build software that can evolve with changing needs.
                        </li>
                        <li>
                            <strong>Thoughtful modernization.</strong>
                            Improve existing systems while managing complexity
                            and risk.
                        </li>
                        <li>
                            <strong>Purposeful innovation.</strong>
                            Apply cloud technologies, AI, and automation
                            where they provide meaningful value.
                        </li>
                        <li>
                            <strong>Transparent collaboration.</strong>
                            Communicate technical decisions, tradeoffs, and
                            priorities clearly.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-pad">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="section-kicker">Our Approach</div>
                <h2 class="section-title">
                    Focused technical expertise without unnecessary complexity.
                </h2>
                <p class="section-text">
                    Every engagement emphasizes technical quality, clear
                    communication, and practical business outcomes. From
                    developing new applications to improving existing
                    platforms, ALVOCOR LLC provides consulting and
                    implementation support tailored to each project's goals.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="mission-panel p-4 p-lg-5">
                    <h3 class="h4 mb-3">Areas of Focus</h3>
                    <ul class="check-list mb-0">
                        <li>Custom software development</li>
                        <li>Enterprise application modernization</li>
                        <li>API and system integration</li>
                        <li>Cloud solutions and workflow automation</li>
                        <li>AI-assisted software development</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>